# Instructions:
# 1. Copy this file to '.env':
#      cp .env.example .env
# 2. Fill in the values appropriate for your environment (development/production).

# Django Secret Key
DJANGO_KEY=django-insecure-replace-this-with-a-random-secret-key

# Database Connection (Optional) (If left unset, Django defaults to local SQLite database (db.sqlite3))
# Examples:
#   PostgreSQL: postgresql://username:password@localhost:5432/chessclub
#   MySQL:      mysql://username:password@localhost:3306/chessclub
DATABASE_URL=sqlite:///db.sqlite3

# Redis Channel Layer URL (Optional)
# If left unset, Django Channels falls back to InMemoryChannelLayer (suitable for local dev) (Eg: redis://127.0.0.1:6379/1)
REDIS_URL=
#Superuser(If left empty, superuser creation during build.sh is skipped)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=change_this_admin_password

